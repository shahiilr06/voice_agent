# ==============================================================================
# LiveKit Cloud Configuration
# ==============================================================================
LIVEKIT_URL=wss://your_project_name.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ==============================================================================
# Sarvam AI Credentials (ASR: Saaras v4, TTS: Bulbul v3, LLM: Sarvam-105b)
# ==============================================================================
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavitha
LLM_MODEL=sarvam-105b-conversations

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=sqlite:///./hotel_booking.db
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg2://hotel:hotel123@localhost:5432/hotel_db

# ==============================================================================
# Application Server
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8004
ENVIRONMENT=development
HOTEL_NAME=Sunrise International Hotel

# ==============================================================================
# Twilio Telephony Configuration (LiveKit SIP Bridge)
# ==============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15157587590
TWILIO_TARGET_PHONE=+919994388773
LIVEKIT_SIP_URI=sip:hotel@your_project_id.sip.livekit.cloud
LIVEKIT_SIP_FORWARD_URI=sip:hotel@your_project_id.sip.livekit.cloud

# ==============================================================================
# Exotel Cloud Telephony Configuration (Optional / Alternative)
# ==============================================================================
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=your_caller_id
EXOTEL_APP_URL=http://my.exotel.com/your_account/exoml/start_voice/xxxx
EXOTEL_TARGET_PHONE=+919994388773
AUTO_CALL_ON_STARTUP=false
